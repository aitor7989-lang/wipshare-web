# Neon Postgres connection string. Use the pooled connection from the Neon
# dashboard ("Connection string" → "Pooled connection"). Make sure sslmode=require
# is in the URL.
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# Cloudflare R2 (S3-compatible). Grab account ID from the Cloudflare dashboard
# (R2 → "Account details"). Create an API token scoped to "Object Read & Write"
# on the wipshare-clips bucket only — the token gives you the access key id +
# secret.
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_token_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_token_secret
R2_BUCKET_NAME=wipshare-clips

# Optional: when you wire up a custom domain in front of R2 (Phase 2B+).
# R2_PUBLIC_HOSTNAME=clips.wipshare.example

# Shared secret for /api/clips/* uploads. Min 16 chars. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# This is a speed bump, not real auth — see lib/auth.ts.
WIPSHARE_UPLOAD_SECRET=change_me_to_a_long_random_string

# Base URL for generated links and OG metadata. No trailing slash.
# Local dev: http://localhost:3000
# Production: https://your-app.vercel.app
NEXT_PUBLIC_BASE_URL=http://localhost:3000
